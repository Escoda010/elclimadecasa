<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 hours"
  ExpiresByType application/javascript "access plus 1 hours"
  ExpiresByType text/javascript "access plus 1 hours"
  ExpiresByType application/json "access plus 1 hours"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|mjs|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|avif|ico|woff|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType application/javascript .js
  AddType text/css .css
  AddType application/json .json
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Sin listado de directorios (lo tenia el .htaccess anterior del servidor)
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Una sola version del dominio: sin www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # /index.html -> /  (evita que la misma pagina viva en dos URLs)
  RewriteCond %{THE_REQUEST} \s/+(([^?\s]*/)?)index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # ── Limpieza de la migracion desde el WordPress viejo (aire acondicionado) ──
  # Legales del WP antiguo -> equivalentes actuales (301, conserva la senal).
  RewriteRule ^aviso-legal/?$          /aviso-legal.html [R=301,L]
  RewriteRule ^politica-de-cookies/?$  /privacidad.html  [R=301,L]
  # Basura de WordPress y contenido viejo sin equivalente -> 410 Gone,
  # para que Google los suelte rapido y dejen de llegar avisos de indexacion.
  RewriteRule ^comments/feed/?$                            - [G,L]
  RewriteRule ^privacy-policy/?$                           - [G,L]
  RewriteRule ^category/                                   - [G,L]
  RewriteRule ^cuantas-frigorias-necesito/?$               - [G,L]
  RewriteRule ^cuanto-cuesta-instalar-aire-acondicionado/?$ - [G,L]
  RewriteRule ^conductos-vs-split/?$                       - [G,L]

  # URLs limpias: /guias/humedad sirve guias/humedad.html
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>
